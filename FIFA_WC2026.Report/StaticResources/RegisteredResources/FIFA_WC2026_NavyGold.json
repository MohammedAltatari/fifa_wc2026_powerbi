{
  "name": "FIFA WC2026 Navy Gold",
  "dataColors": [
    "#D4AF37",
    "#4FC3F7",
    "#E8EDF5",
    "#F28C6B",
    "#5DD39E",
    "#B39DDB",
    "#F6D365",
    "#7E8BA3"
  ],
  "background": "#0B1426",
  "foreground": "#F2F4F8",
  "tableAccent": "#D4AF37",
  "good": "#5DD39E",
  "neutral": "#F6D365",
  "bad": "#F28C6B",
  "maximum": "#D4AF37",
  "center": "#7E8BA3",
  "minimum": "#1B2E52",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#D4AF37"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#F2F4F8"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#D4AF37"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#A9B4C8"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#12203A"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#24395F"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F2F4F8"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": false,
            "fontColor": {
              "solid": {
                "color": "#A9B4C8"
              }
            },
            "fontSize": 9
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#12203A"
              }
            },
            "foreground": {
              "solid": {
                "color": "#D4AF37"
              }
            },
            "border": {
              "solid": {
                "color": "#12203A"
              }
            },
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#A9B4C8"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#A9B4C8"
              }
            },
            "fontSize": 9,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#A9B4C8"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#A9B4C8"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#24395F"
              }
            },
            "gridlineStyle": "dotted",
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#A9B4C8"
              }
            },
            "fontSize": 9,
            "position": "Top"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F2F4F8"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0B1426"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#070E1B"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#D4AF37"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold",
            "labelDisplayUnits": 1
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#A9B4C8"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "title": [
          {
            "show": true
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#12203A"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#D4AF37"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#162847"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#A9B4C8"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#0B1426"
              }
            }
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#F1D581"
              }
            }
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#24395F"
              }
            },
            "weight": 1,
            "transparency": 0
          },
          {
            "$id": "selected",
            "lineColor": {
              "solid": {
                "color": "#D4AF37"
              }
            }
          }
        ],
        "shape": [
          {
            "tileShape": "rectangleRounded",
            "rectangleRoundedCurve": 8
          }
        ],
        "pages": [
          {
            "showHiddenPages": false,
            "showTooltipPages": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#D4AF37"
              }
            },
            "textSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F2F4F8"
              }
            },
            "background": {
              "solid": {
                "color": "#12203A"
              }
            },
            "textSize": 10
          }
        ],
        "data": [
          {
            "mode": "Dropdown"
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#24395F"

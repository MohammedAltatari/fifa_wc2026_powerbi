            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#24395F"
              }
            },
            "rowPadding": 4,
            "textSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#D4AF37"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F1B33"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#F2F4F8"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#12203A"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F2F4F8"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#162847"
              }
            },
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#D4AF37"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F1B33"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#24395F"
              }
            },
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#24395F"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#D4AF37"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F1B33"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#F2F4F8"
              }
            },
            "backColor": {
              "solid": {
                "color": "#12203A"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#F2F4F8"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#12203A"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F2F4F8"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#162847"
              }
            }
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "markers": [
          {
            "transparency": 25,
            "borderShow": false
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#A9B4C8"
              }
            },
            "fontSize": 8
          }
        ]
      }
    }
  }
}
		summarizeBy: sum
		sourceColumn: points

		annotation SummarizationSetBy = Automatic

	partition Fact_TeamMatch = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Raw_PlayerMatch,
				    // One row per team per match (2 rows per match). Team score comes from goals_team, NOT from the sum of player goals.
				    Grouped = Table.Group(
				        Source,
				        {"match_id", "match_date", "stadium", "team", "opponent_team", "match_result", "goals_team", "goals_opponent"},
				        {
				            {"xg_for", each Number.Round(List.Sum([expected_goals_xg]), 2), type number},
				            {"shots_for", each List.Sum([shots]), Int64.Type},
				            {"shots_on_target_for", each List.Sum([shots_on_target]), Int64.Type},
				            {"player_goals_sum", each List.Sum([goals]), Int64.Type},
				            {"yellow_cards", each List.Sum([yellow_cards]), Int64.Type},
				            {"red_cards", each List.Sum([red_cards]), Int64.Type}
				        }
				    ),
				    // Self-join to bring the opponent's xG and shots onto the same row
				    Opponent = Table.SelectColumns(Grouped, {"match_id", "team", "xg_for", "shots_for", "shots_on_target_for"}),
				    Merged = Table.NestedJoin(Grouped, {"match_id", "opponent_team"}, Opponent, {"match_id", "team"}, "Opp", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Merged, "Opp", {"xg_for", "shots_for", "shots_on_target_for"}, {"xg_against", "shots_against", "shots_on_target_against"}),
				    Renamed = Table.RenameColumns(Expanded, {{"match_result", "result"}, {"goals_team", "goals_for"}, {"goals_opponent", "goals_against"}}),
				    AddPoints = Table.AddColumn(Renamed, "points", each if [result] = "W" then 3 else if [result] = "D" then 1 else 0, Int64.Type),
				    Typed = Table.TransformColumnTypes(AddPoints, {
				        {"match_id", type text}, {"match_date", type date}, {"stadium", type text}, {"team", type text},
				        {"opponent_team", type text}, {"result", type text}, {"goals_for", Int64.Type}, {"goals_against", Int64.Type},
				        {"xg_for", type number}, {"xg_against", type number}, {"shots_for", Int64.Type}, {"shots_against", Int64.Type},
				        {"shots_on_target_for", Int64.Type}, {"shots_on_target_against", Int64.Type}, {"player_goals_sum", Int64.Type},
				        {"yellow_cards", Int64.Type}, {"red_cards", Int64.Type}, {"points", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table


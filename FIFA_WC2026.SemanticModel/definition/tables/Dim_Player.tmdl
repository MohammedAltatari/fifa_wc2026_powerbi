	column 'Value Band Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 307b8059-c5f4-5e2d-9ed5-7c2630426ab0
		summarizeBy: none
		sourceColumn: Value Band Order

		annotation SummarizationSetBy = Automatic

	partition Dim_Player = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Raw_PlayerMatch,
				    Selected = Table.SelectColumns(Source, {"player_id", "player_name", "age", "nationality", "team", "jersey_number", "position", "height_cm", "weight_kg", "preferred_foot", "club_name", "market_value_eur"}),
				    // Player attributes are constant across matches (verified), so one row per player_id
				    Distinct = Table.Distinct(Selected, {"player_id"}),
				    // 3 pairs of team-mates share the same name -> add the shirt number to make labels unique
				    NameCounts = Table.Group(Distinct, {"player_name"}, {{"NameCount", each Table.RowCount(_), Int64.Type}}),
				    JoinedCounts = Table.NestedJoin(Distinct, {"player_name"}, NameCounts, {"player_name"}, "N", JoinKind.LeftOuter),
				    ExpandedCounts = Table.ExpandTableColumn(JoinedCounts, "N", {"NameCount"}),
				    AddLabel = Table.AddColumn(ExpandedCounts, "Player Label", each if [NameCount] > 1 then [player_name] & " #" & Text.From([jersey_number]) else [player_name], type text),
				    AddPositionOrder = Table.AddColumn(AddLabel, "Position Order", each List.PositionOf({"Goalkeeper", "Defender", "Midfielder", "Forward"}, [position]) + 1, Int64.Type),
				    AddAgeGroup = Table.AddColumn(AddPositionOrder, "Age Group", each
				        if [age] <= 21 then "21 & under"
				        else if [age] <= 25 then "22-25"
				        else if [age] <= 29 then "26-29"
				        else if [age] <= 33 then "30-33"
				        else "34+", type text),
				    AddAgeGroupOrder = Table.AddColumn(AddAgeGroup, "Age Group Order", each List.PositionOf({"21 & under", "22-25", "26-29", "30-33", "34+"}, [Age Group]) + 1, Int64.Type),
				    AddValueM = Table.AddColumn(AddAgeGroupOrder, "Market Value (EUR M)", each [market_value_eur] / 1000000, type number),
				    AddValueBand = Table.AddColumn(AddValueM, "Value Band", each
				        if [market_value_eur] < 5000000 then "Under 5M"
				        else if [market_value_eur] < 10000000 then "5M-10M"
				        else if [market_value_eur] < 20000000 then "10M-20M"
				        else if [market_value_eur] < 50000000 then "20M-50M"
				        else "50M+", type text),
				    AddValueBandOrder = Table.AddColumn(AddValueBand, "Value Band Order", each List.PositionOf({"Under 5M", "5M-10M", "10M-20M", "20M-50M", "50M+"}, [Value Band]) + 1, Int64.Type),
				    Removed = Table.RemoveColumns(AddValueBandOrder, {"NameCount"}),
				    Typed = Table.TransformColumnTypes(Removed, {
				        {"player_id", type text}, {"player_name", type text}, {"age", Int64.Type}, {"nationality", type text},
				        {"team", type text}, {"jersey_number", Int64.Type}, {"position", type text}, {"height_cm", Int64.Type},
				        {"weight_kg", Int64.Type}, {"preferred_foot", type text}, {"club_name", type text}, {"market_value_eur", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table


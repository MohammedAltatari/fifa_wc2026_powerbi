	partition Fact_PlayerMatch = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Raw_PlayerMatch,
				    // Keep keys + per-match metrics only.
				    // Dropped on purpose: player/match attributes (live in dimensions), goals_team/goals_opponent (live in Fact_TeamMatch),
				    // pass_accuracy & save_percentage (inconsistent with their own components - recomputed in DAX),
				    // total_*_tournament, tournament_rating, player_of_match_awards (not stable per player - unreliable).
				    Selected = Table.SelectColumns(Source, {"player_id", "match_id", "team", "opponent_team", "match_date", "stadium", "match_result", "minutes_played", "goals", "assists", "shots", "shots_on_target", "key_passes", "successful_passes", "total_passes", "dribbles_attempted", "successful_dribbles", "crosses", "successful_crosses", "tackles", "interceptions", "clearances", "blocks", "aerial_duels_won", "aerial_duels_lost", "recoveries", "defensive_actions", "fouls_committed", "fouls_suffered", "yellow_cards", "red_cards", "offsides", "saves", "punches", "clean_sheet", "goals_conceded", "penalty_saves", "accelerations", "decelerations", "expected_goals_xg", "expected_assists_xa", "distance_covered_km", "sprint_distance_km", "top_speed_kmh", "stamina_score", "player_rating", "performance_score", "offensive_contribution", "defensive_contribution", "possession_impact", "pressure_resistance", "creativity_score", "consistency_score", "clutch_performance_score"}),
				    Renamed = Table.RenameColumns(Selected, {{"match_result", "result"}}),
				    // 1 = the player actually played (minutes > 0). 42% of rows are unused substitutes.
				    AddAppearance = Table.AddColumn(Renamed, "is_appearance", each if [minutes_played] > 0 then 1 else 0, Int64.Type)
				in
				    AddAppearance

	annotation PBI_ResultType = Table

